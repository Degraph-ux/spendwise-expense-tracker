# SpendWise Environment Configuration Example

PORT=3000
SPENDWISE_APP_URL=http://localhost:3000

# Enable development authentication on localhost (verification links logged to console, auto-managed MFA)
SPENDWISE_DEV_AUTH=true

# Set to true to bypass email verification and MFA for seamless local development
SPENDWISE_DEV_SKIP_EMAIL_MFA=true

# Encryption key for multi-factor authentication secrets (at least 32 characters)
SPENDWISE_MFA_ENCRYPTION_KEY=replace-with-a-secret-key-of-at-least-32-characters

# SMTP Configuration (optional for local development, required for production email verification)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=secretpassword
# SMTP_FROM=SpendWise <noreply@example.com>
# SMTP_SECURE=false

# Supabase project configuration (the publishable/anon key is safe for RLS-scoped requests)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-publishable-or-anon-key
# SPENDWISE_STORAGE=supabase

# Only for the one-time legacy data migration command; never use in the running app.
# SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key
